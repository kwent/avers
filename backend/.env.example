# Vision model access: a Vercel AI Gateway key (https://vercel.com/docs/ai-gateway)
AI_GATEWAY_API_KEY=
# Optional: which model reads the photos, and the fallbacks tried if it fails (comma-separated).
# Defaults chosen with bench/models.py.
# VISION_MODEL=google/gemini-3.5-flash-lite
# VISION_FALLBACK_MODELS=google/gemini-3.8-flash
# Optional: second look at a reading that is unidentifiable or below VISION_ESCALATE_BELOW, by the first of these
# models that answers (empty: off).
# VISION_ESCALATION_MODELS=google/gemini-3.8-flash,anthropic/claude-opus-5.5
# VISION_ESCALATE_BELOW=0.99

# Optional shared secret; the app sends it as X-App-Token. Set it before exposing the API beyond your LAN.
APP_TOKEN=

# Collection storage: Postgres when set (hosted API), else the local SQLite file below.
# DATABASE_URL=postgresql://...

# Web build of the app served from another origin (comma-separated).
# CORS_ORIGINS=https://avers.vercel.app

# Optional path overrides; relative paths are resolved from backend/ (default: ../data/...)
# COINS_DB=../data/coins.sqlite
# COINS_DB_READONLY=1           # catalog on a read-only disk (hosted API)
# COINS_IMAGES=../data/images
# VISION_ONNX=../data/models/dinov2-small.onnx
# COLLECTION_DB=../data/collection.sqlite
