# Vision model access: a Vercel AI Gateway key (https://vercel.com/docs/ai-gateway)
AI_GATEWAY_API_KEY=
# Optional: which model reads the photos, and the fallbacks tried if it fails (comma-separated).
# Defaults chosen with bench/models.py.
# VISION_MODEL=google/gemini-3.5-flash-lite
# VISION_FALLBACK_MODELS=google/gemini-3.8-flash

# Optional shared secret; the app sends it as X-App-Token. Set it before exposing the API beyond your LAN.
APP_TOKEN=

# Optional path overrides (default: ../data/...)
# COINS_DB=../data/coins.sqlite
# COINS_IMAGES=../data/images
# COLLECTION_DB=../data/collection.sqlite
# UPLOADS_DIR=../data/uploads
