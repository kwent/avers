{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "regions": [
    "fra1"
  ],
  "functions": {
    "app/main.py": {
      "maxDuration": 800,
      "includeFiles": ".deploy/**"
    }
  },
  "crons": [
    {
      "path": "/cron/catalog",
      "schedule": "0 3 * * 1"
    }
  ]
}
