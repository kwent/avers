{
  "expo": {
    "name": "Avers",
    "slug": "avers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kwent.avers",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#17130E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kwent.avers",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Avers uses the camera to photograph your coins."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Avers accesses your photos to estimate a coin you already photographed."
        }
      ],
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#110E0A"
        }
      ]
    ],
    "scheme": "avers",
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "fr": "./locales/fr.json",
      "en": "./locales/en.json"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "654e128f-6ba6-49a0-86be-b69b0b91cdf8"
      }
    },
    "owner": "avers"
  }
}
