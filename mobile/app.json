{
  "expo": {
    "name": "Avers",
    "slug": "avers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kwent.avers"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F3EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kwent.avers"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Avers utilise l’appareil photo pour photographier vos pièces."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Avers accède à vos photos pour estimer une pièce déjà photographiée."
        }
      ]
    ],
    "scheme": "avers",
    "experiments": {
      "typedRoutes": true
    }
  }
}
